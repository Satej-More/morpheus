# ════════════════════════════════════════════════════════
#  MORPHEUS — Environment Configuration
#  Copy this file to backend/.env and fill in values
# ════════════════════════════════════════════════════════

# ─── Google / Gemini ─────────────────────────────────────────────────────────
# Get free key at: https://aistudio.google.com/apikey
# Standard key is EXACTLY 39 characters: AIzaSy... (38 more chars)
# If you get "API_KEY_INVALID" → regenerate a fresh key
GOOGLE_API_KEY=AIzaSy_YOUR_39_CHAR_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash-exp

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Free Atlas cluster: https://cloud.mongodb.com
# Local Docker: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=morpheus

# ─── Dynatrace ───────────────────────────────────────────────────────────────
# Free trial (no credit card): https://www.dynatrace.com/trial
#
# IMPORTANT — Token scopes needed (Settings → Access tokens → Generate):
#   For DQL/Grail (new): storage:logs:read, storage:metrics:read,
#                         storage:events:read, storage:buckets:read
#   For V2 API (classic): metrics.read, logs.read, problems.read,
#                          events.read, entities.read
#   → Enable ALL of these to ensure maximum compatibility
#
DYNATRACE_API_URL=https://XXXXXXXX.live.dynatrace.com
DYNATRACE_API_TOKEN=dt0c01.XXXXXXXXXXXXXXXXXXXX.YYYYYYYYYYYYYYYY

# ─── GitHub ──────────────────────────────────────────────────────────────────
# Personal access token: https://github.com/settings/tokens
# Required permissions: repo (full), issues:write
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXX
GITHUB_REPO=your-username/your-repo

# ─── Slack ───────────────────────────────────────────────────────────────────
# Incoming webhook: https://api.slack.com/apps → Your App → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_CHANNEL=#incidents-critical

# ─── Agent Behavior ──────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60
CONFIDENCE_THRESHOLD=0.70
MTTR_TARGET_SECONDS=300
DEBUG=false
